          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "East",
          "TargetId": 7913,
          "Description": "You see a huge metal door. From it a foul stench emanates. The smell is the\nmost awful experience in your entire life. A thought seeps through this\nterrible stench and into your mind : \"Monsters\", you feel BAD about opening\nthat door.",
          "Keywords": [
            "steel",
            "metal",
            "huge"
          ],
          "ExitFlags": [
            "Closed"
          ],
          "KeyId": null
        },
        {
          "Direction": "South",
          "TargetId": 7901,
          "Description": "The rest of the hall lies in that direction, and so does the exit.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "West",
          "TargetId": 7905,
          "Description": "The door has \"SITTING ROOM\" written on it. It is made from Aspenwood and is\nbeautifully carved with small elves as main issue of sculpture.",
          "Keywords": [
            "aspen",
            "asp"
          ],
