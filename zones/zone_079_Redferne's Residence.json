    {
      "Id": 7904,
      "Name": "The Northern end of the hall",
      "Description": "\n   You are standing in the northern end of the huge hall. This part is under\nthe grand wooden staircase so the light seems a little less bright here, but\nthis doesn't bother your sight at all. To the north lies the kitchen. To the\nsouth lies the Southern end of the hall. To the east there is a huge metal\ndoor. To the west there is a large aspenwood door.",
      "ZoneId": 79,
      "Sector": "Inside",
      "Flags": [
        "NoMob",
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "North",
          "TargetId": 7906,
          "Description": "",
