    },
    {
      "Id": 7905,
      "Name": "The Sitting room of Naris",
      "Description": "\n   You are standing in the middle of a really comfortable place. The walls are\ndecorated with paintings of smiling Kings and Queens. The most attractive\npicture is one of a Prince in shiny armor. By one of the walls there is an old\narm-chair. The only exit is through the aspenwood door to the east.",
      "ZoneId": 79,
      "Sector": "Inside",
      "Flags": [
        "NoMob",
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "East",
          "TargetId": 7904,
          "Description": "The door seems to be a very HEAVY door, carved completely from the trunk of an\nAspen tree.",
          "Keywords": [
            "asp",
            "aspen",
            "door",
            "heavy"
          ],
          "ExitFlags": [
            "Closed"
          ],
          "KeyId": null
        }
