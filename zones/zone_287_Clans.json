    {
      "Id": 28704,
      "Name": "The Entrance to the Four Winds",
      "Description": "\n   What was once a grand tavern has fallen to disrepair.  When Midgaard was\nnew and prosperous, The Four Winds was the finest inn in all the lands,\nthe only one allowed to build upon the temple complex itself.  When the\ncreatures and beasts invaded the kingdom, it fell on hard times, until\nwhat had become a sleazy brothel and bar was finally boarded up,\nforgotten by all.  Not so anymore!  Now it has been reopened, and is\nslowly becoming grand again.  No longer a tavern, the four stone\nguardians watch the comings and goings of the guild members of the\nAdventurer's Guild.",
      "ZoneId": 287,
      "Sector": "Inside",
      "Flags": [
        "Indoors",
        "NoTeleport",
        "NoTrack",
        "NoSweep"
      ],
      "Exits": [
        {
          "Direction": "North",
          "TargetId": 28701,
          "Description": "Before you is a statue, dedicated to the North Wind.  Lord of the\nstorms, he is both the guardian of sailors and the harbinger of doom.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "East",
          "TargetId": 28705,
          "Description": "Before you is a statue in homage to the East Wind.  Lord of the tides,\nhe is a fickle guardian, protecting when he sees fit, leaving as he\nchooses.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "South",
          "TargetId": 28707,
          "Description": "Before you is the South Wind, cast in stone.  His visage is kind and\ngentle, but a deeper look shows an iciness and violence that leaves you\ncold.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "West",
          "TargetId": 28703,
          "Description": "Before you, a statue dedicated to the West Wind rises majestically.\nMost favored of the Winds, he is constant and kind, driving storms away\nand guiding sailors' home.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "Down",
          "TargetId": 3000,
