      "CrashRoom": false
    },
    {
      "Id": 28705,
      "Name": "The Board Room",
      "Description": "\n   This quiet room is dedicated to the study and research it takes to\nsurvive in the violent world around us.  Scrolls and tomes litter the\ntables.  Many have been left sitting open, as foolish recruits often\nrace off to try a new technique without finishing the lesson.  Will \nyou be so foolish?  Will your body feed some fell beast?  Look to the \nboards for the keys to survival!",
      "ZoneId": 287,
      "Sector": "Inside",
      "Flags": [
        "Indoors",
        "Silent",
        "NoTeleport",
        "NoTrack",
        "NoSweep"
