  "Rooms": [
    {
      "Id": 22902,
      "Name": "Hidden Path",
      "Description": "\n   Welcome to the Midgaard Honeymoon Resort.  We have designed this area\nespecially for you on this special day.  Before you, just a little up the\nmountain side, is a beautiful cottage with everything you could want on your\nhoneymoon.  So what are you waiting on, come on up and begin your lives\ntogether here with us at Honeymoon Resort!",
      "ZoneId": 229,
      "Sector": "Inside",
      "Flags": [],
      "Exits": [
        {
          "Direction": "Up",
          "TargetId": 22903,
          "Description": "Up the path is a beautiful cottage just waiting for you to enter.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": 0
        }
      ],
      "ExtraDescriptions": [],
      "SpecialProc": null,
      "RoomPrograms": [],
      "CrashRoom": false
    },
    {
      "Id": 22903,
      "Name": "Front Porch",
      "Description": "\n   You come up onto the front porch of the cottage. Before you is the door \nto your cottage.  All around you is a beautiful view of the mountains. \nProvided for your comfort is a double wide lounge chair.  Beside the chair is\na bottle of wine for you to enjoy along with the view.",
      "ZoneId": 229,
      "Sector": "Inside",
      "Flags": [],
      "Exits": [
        {
          "Direction": "North",
          "TargetId": 22904,
          "Description": "On the door is a sign that says:\n\n                     Welcome to honeymoon Resort\n                     May your first day of your \n                     lives together only be a \n                     small sample of the joy\n                     and happiness that waits you\n                     in the coming days together.\n\n                     Midgaard Management HM Resort",
          "Keywords": [
            "door",
            "sign"
          ],
          "ExitFlags": [
            "Closed"
          ],
          "KeyId": 22910
        },
        {
          "Direction": "East",
          "TargetId": 22999,
          "Description": "The east provides a beautiful view of a mountain lake complete with\na dock and small boat for your pleasure.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": 0
        },
        {
          "Direction": "South",
          "TargetId": 21099,
          "Description": "Before you is the path down the mountain.  Not to far from the cabin it \ndisappears into the trees.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": 0
        },
        {
          "Direction": "West",
          "TargetId": 21099,
          "Description": "2\n  To the west is a beautiful sunset splendid with the glow of reds and \norange, a more beautiful site you have never seen.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": 0
        },
        {
          "Direction": "Down",
          "TargetId": 22902,
          "Description": "Down below is the path back to the mundane world.",
