      "ExtraDescriptions": [
        {
          "Keywords": [
            "floor"
          ],
          "Description": "\nThe stone floor is the same shade of gray as the sky and is completely plain\nand unscratched.  It is probably too hard for anything to leave as much as a\nscratch on it."
        },
        {
          "Keywords": [
            "sky",
            "wind",
            "winds"
          ],
          "Description": "\nCold winds plunge ceaselessly at you from the dark, cloudless sky."
        }
      ],
