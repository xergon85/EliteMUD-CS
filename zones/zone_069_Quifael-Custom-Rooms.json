      "Id": 6999,
      "Name": "The Realm of the Dead",
      "Description": "\n   You are standing on an immense, gray stone floor that stretches as far as\nyou can see in all directions. Rough winds plunging from the dark, starless sky\ntear savagely at your fragile body.",
      "ZoneId": 69,
      "Sector": "Inside",
      "Flags": [
        "Indoors",
        "Private",
