  "Rooms": [
    {
      "Id": 6900,
      "Name": "Quifael's monster pen",
      "Description": "\n   You are in a big, subterranean room with heavy massive stone walls and no\nwindows whatsoever. A virtual ladder leads upwards.",
      "ZoneId": 69,
      "Sector": "Inside",
      "Flags": [
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "Up",
          "TargetId": 6902,
          "Description": "The ladder leads to the laboratory.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        }
      ],
      "ExtraDescriptions": [],
      "SpecialProc": null,
      "RoomPrograms": [],
      "CrashRoom": false
    },
    {
      "Id": 6901,
      "Name": "Quifael's study",
      "Description": "\n   You are in a small, comfortable study room. The walls are lined with\nbookcases filled with dusty volumes of all sizes. In the fireplace burns a\ncrackling fire that makes the room warm and cozy, and in front of an oakwood\nreading desk is a large old-fashioned chair.",
      "ZoneId": 69,
      "Sector": "Inside",
      "Flags": [
        "NoMob",
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "South",
          "TargetId": 6904,
          "Description": "The corridor leads south to the hall.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        }
      ],
      "ExtraDescriptions": [
        {
          "Keywords": [
            "bookcase",
            "bookcases",
            "volume",
            "volumes",
            "book",
            "books"
          ],
          "Description": "\nMost of the books are heavy, leather-bound and covered in a thin layer of dust.\nThere are many titles on necromancy, conjuring and other spheres of Magic,\nbut also some on computer science (although these seem to be VERY dusty\nindeed) and a fair collection of horror literature, ranging from Bram Stoker\nand H. P. Lovecraft to Anne Rice and Stephen King."
        },
        {
          "Keywords": [
            "fireplace"
          ],
          "Description": "\nThe fireplace isn't particularly big, but the fire crackles merrily in it."
        },
        {
          "Keywords": [
            "desk"
          ],
          "Description": "\nIt is very massive and but seems worn from many years of use."
        },
        {
          "Keywords": [
            "chair"
          ],
          "Description": "\nIt is big and old-fashioned, but quite comfortable nevertheless."
        }
      ],
      "SpecialProc": null,
      "RoomPrograms": [],
      "CrashRoom": false
    },
    {
      "Id": 6902,
      "Name": "Quifael's laboratory",
      "Description": "\n   You are in a room filled with shelves containing all sorts of weird\nequipment. The walls are lined with numerous shelves and a massive working desk\nis by the north wall. The air smells of rare chemicals and spices. A virtual\nladder leads downwards. A magical portal is hovering in the air just in front\nof the east wall.",
      "ZoneId": 69,
      "Sector": "Inside",
      "Flags": [
        "NoMob",
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "East",
          "TargetId": 6903,
          "Description": "To the east is the magical portal.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "West",
          "TargetId": 6904,
          "Description": "The hall is to the west.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        },
        {
          "Direction": "Down",
          "TargetId": 6900,
          "Description": "The virtual ladder leads down to the monster pen.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        }
      ],
      "ExtraDescriptions": [
        {
          "Keywords": [
            "shelves"
          ],
          "Description": "\nThe shelves contain a mass of bottles, jars and boxes of different shapes and\nsizes, of which some contain powders and liquids in various colors.  Others\ncontain dragon's claws, giant's eyes, rabbit's ears and other body parts of\ndifferent monsters."
        },
        {
          "Keywords": [
            "desk"
          ],
          "Description": "\nOn the desk is a peculiar apparatus of glass bottles and globes connected by\nsmall pipelines.  The green liquid inside the apparatus' globes and pipelines\nis bubbling steadily."
        }
      ],
      "SpecialProc": null,
      "RoomPrograms": [],
      "CrashRoom": false
    },
    {
      "Id": 6903,
      "Name": "Quifael's virtual balcony",
      "Description": "\n   You are on a transparent balcony hanging in mid-air. You notice a faint blue\nglow surrounding everything, even yourself, making it seem as transparent as\nthe balcony itself. From here, you have a terrific view of the whole Forest of\nHaon-Dor. A transparent bronze plate has been bolted to the balcony railing. A\nmagical portal is hovering in the air to the west.",
      "ZoneId": 69,
      "Sector": "Inside",
      "Flags": [
        "Indoors",
        "Private"
      ],
      "Exits": [
        {
          "Direction": "West",
          "TargetId": 6902,
          "Description": "The magical portal is to the west.",
          "Keywords": [],
          "ExitFlags": [],
          "KeyId": null
        }
      ],
      "ExtraDescriptions": [
        {
          "Keywords": [
            "balcony",
            "railing"
          ],
          "Description": "\nQuite transparent, but visible anyway, because of the blue glow that surrounds\nthe whole place."
        },
        {
          "Keywords": [
            "plate"
          ],
          "Description": "\nThe transparent bronze plate looks quite strange, but the engraved letters are\nquite easy to read, nevertheless :-\n\n              Quifael's Virtual Balcony\n\n                   Do not lean out!\n\n  Please do not try to attract the attention of any\n      adventurers in the forest, as you are not\n         really in existence at the moment.\n\n        (This could possibly mess up Reality,\n      and we wouldn't want to do that, would we?)"
        },
        {
          "Keywords": [
            "forest",
            "Haon-Dor",
            "view"
          ],
          "Description": "\nThrough the tree crowns, you see fellow adventurers walking around in the\nforest, gathering mushrooms, eating blackberries, committing rabbit genocide\nand generally having a good time."
        }
      ],
      "SpecialProc": null,
      "RoomPrograms": [],
      "CrashRoom": false
    },
